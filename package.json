{
  "name": "@naiba/pi-durable-background-tasks",
  "version": "0.2.0",
  "description": "Background shell tools for Pi Durable; no model delegation",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naiba/pi-durable-background-tasks.git"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./pi": {
      "bun": "./src/pi.ts",
      "types": "./src/pi.ts",
      "default": "./dist/pi.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && cp src/process-supervisor.py dist/process-supervisor.py",
    "test": "bun test",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-durable": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/bun": "^1.4.3",
    "typescript": "~7.0.2",
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0"
  }
}
